{
  "name": "FRC CodeRunner Bulletproof",
  "image": "mcr.microsoft.com/devcontainers/java:17-ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "wpilibsuite.vscode-wpilib"
      ]
    }
  },
  "forwardPorts": [4000, 5800, 1181],
  "portsAttributes": {
    "4000": { "label": "CodeRunner IDE", "onAutoForward": "openBrowser" },
    "5800": { "label": "AdvantageScope", "onAutoForward": "openPreview" }
  },
  "postStartCommand": "CODERUNNER_DEMO_MODE=1 docker compose --profile full up -d"
}